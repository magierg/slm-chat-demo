# Works with any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM, ...).
#
# Ollama:     `ollama serve`              ->  http://localhost:11434/v1
# LM Studio:  start the local server      ->  http://localhost:1234/v1
#
# Copy this file to `.env` and edit as needed.

SLM_BASE_URL=http://localhost:11434/v1

# Any local model works. Smaller models are faster; bigger models follow
# instructions and call tools more reliably. Reasoning examples:
#   lfm2.5-2.6b-4bit   - always thinks, fast (rapid-mlx)
#   ling-3.0-tiny-4bit - stronger chain-of-thought, needs SLM_ENABLE_THINKING=true
SLM_MODEL=llama3.2:3b

SLM_API_KEY=ollama
SLM_TEMPERATURE=0.7

# Reasoning models (e.g. LFM2.5, Ling) spend tokens thinking before answering, and
# that counts against this budget - keep it generous so answers aren't truncated.
SLM_MAX_TOKENS=4096

# Optional: cap only the thinking portion (rapid-mlx). Keeps reasoning fast and
# predictable without limiting the answer. Unset = no cap. Override with --think-budget.
# SLM_REASONING_MAX_TOKENS=512

# Ask the model to think before answering (rapid-mlx `enable_thinking`).
# Ling defaults reasoning OFF, so set true to get chain-of-thought; LFM ignores it.
# Set empty (SLM_ENABLE_THINKING=) to omit the field on servers that reject it.
SLM_ENABLE_THINKING=true
